{
  "name": "mergepay",
  "version": "0.1.0",
  "description": "Pay a maintainer-approved contributor after a genuinely merged pull request, via KeeperHub on a testnet.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20 || ^22"
  },
  "main": "dist/index.js",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.mjs\" \"*.ts\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "ncc build src/action.ts --out dist --minify --source-map",
    "bundle:check": "node -e \"require('fs').existsSync('dist/index.js') || process.exit(1)\" && node --input-type=module -e \"import('./dist/index.js').then(()=>console.log('bundle loads')).catch(e=>{console.error(e);process.exit(1)})\"",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^9.0.0",
    "yaml": "^2.4.5"
  },
  "overrides": {
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.16.0",
    "vitest": "^3.2.6"
  }
}
