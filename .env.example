# MergePay environment example
#
# Copy to `.env` (never commit) for local fixture runs.
# In GitHub Actions, provide the same values as secrets.

# Organization API key for KeeperHub Direct Execution (prefix kh_).
# Create at Settings > API Keys > Organisation on app.keeperhub.com.
KEEPERHUB_API_KEY=kh_replace_me

# GitHub token used by the action. In CI this is auto-provided by
# actions/checkout + the GITHUB_TOKEN context.
GITHUB_TOKEN=

# Dedicated secret used to authenticate receipt markers (HMAC). Independent
# of the KeeperHub key so that rotating the provider credential does not
# invalidate historical receipts. Generate a long random value.
MERGE_PAY_RECEIPT_SECRET=

# Optional previous receipt secret, accepted for verification only during a
# rotation window. Set it to the prior MERGE_PAY_RECEIPT_SECRET value when
# rotating, then remove it after the previous receipts are retired.
MERGE_PAY_RECEIPT_SECRET_PREVIOUS=
